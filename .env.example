# ─────────────────────────────────────────────────────────────────────────────
# Verbo AI consultant — пример переменных окружения.
# Скопируйте в .env для локального запуска. В репозиторий .env НЕ коммитим.
# На Render эти же переменные задаются в разделе Environment.
# ─────────────────────────────────────────────────────────────────────────────

# --- Модель (Google Gemini по API) ---
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Необязательно — переопределить модели (по умолчанию flash-latest / flash-lite-latest):
# GEMINI_MODEL_MAIN=gemini-flash-latest
# GEMINI_MODEL_CHEAP=gemini-flash-lite-latest

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE_ROLE ключ используется ТОЛЬКО на сервере (обходит RLS для вставки заявок
# и чтения в админке). НИКОГДА не попадает в клиентский код.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# Прямое SQL-подключение (миграции, ручные запросы). Хост *.pooler.supabase.com —
# это Supavisor-пулер (НЕ путать со старым прямым db.<ref>.supabase.co). Режим
# выбирается портом:
#   5432 — session mode: удобно для миграций и psql;
#   6543 — transaction mode: для приложений с множеством коротких запросов
#          (на Render воркеры не упираются в лимит коннектов).
# Приложению это НЕ нужно: оно ходит в Supabase по REST (SUPABASE_URL + ключ).
# Пароль со спецсимволами — percent-encode.
# DATABASE_URL=postgresql://postgres.your-ref:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres

# --- Telegram-уведомления владельцу о новых заявках ---
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# --- Админ-вкладка «Заявки» ---
ADMIN_PASSWORD=change-me-please

# --- Активная школа (тенант) ---
# Какой конфиг из configs/ поднимать. По умолчанию configs/verbo_ru.yaml
# (русская школа). Для международного англ. демо:
SCHOOL_CONFIG=configs/brightpath_en.yaml

# --- Прочее ---
# PORT задаёт Render сам; локально можно не указывать (по умолчанию 7860).
# PORT=7860
# CALL_TIMEOUT=30
# HISTORY_WINDOW=12
